# ======================================================
# Developer Behaviour Tracker – Application Configuration TEMPLATE
#
# Copy this file to application.properties and fill in your values.
# NEVER commit application.properties with real credentials.
# ======================================================

# ----- Server -----
server.port=8080

# ----- PostgreSQL DataSource -----
# Placeholders only – values come from environment variables. Set DB_USERNAME and DB_PASSWORD
# (DB_HOST, DB_PORT and DB_NAME are optional) in your shell or IDE run configuration, or replace
# the placeholders in your local, git-ignored application.properties. Never put real values here.
spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:developer_behavior}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver

# ----- HikariCP connection pool -----
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.connection-timeout=30000

# ----- JPA / Hibernate -----
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=false

# ----- GitHub API (token verification for /api/auth/github) -----
# Optional – defaults to https://api.github.com
#github.api.base-url=https://api.github.com

# ----- Springdoc / Swagger -----
springdoc.api-docs.path=/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.operationsSorter=method

# ----- Logging -----
logging.level.com.sentinel=INFO
logging.level.org.springframework.web=WARN
